@page "/facturas-archivadas"
@using Microsoft.EntityFrameworkCore
@inject FacturasDb Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container mt-4">
    <h1 class="mb-4 text-center text-warning">
        <i class="bi bi-archive me-2"></i> Facturas Archivadas
    </h1>

    @if (!autenticado)
    {
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <h5 class="card-title text-center mb-4">🔒 Acceso Restringido</h5>
                <p class="text-center text-muted mb-4">Ingresa la contraseña para ver las facturas archivadas</p>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger">@mensajeError</div>
                }

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" class="form-control" @bind="contraseñaIngresada" @onkeypress="VerificarEnter" />
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary" @onclick="VerificarContraseña">
                        <i class="bi bi-key"></i> Acceder
                    </button>
                    <button class="btn btn-secondary" @onclick="MenuPrincipal">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Barra de búsqueda -->
        @if (todasLasFacturas.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Buscar por cliente, ID o total..."
                                       @bind="textoBusqueda"
                                       @bind:event="oninput"
                                       @onkeyup="FiltrarFacturas" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" @bind="ordenarPor" @bind:after="OrdenarFacturas">
                                <option value="fecha-desc">Más recientes</option>
                                <option value="fecha-asc">Más antiguas</option>
                                <option value="cliente">Cliente (A-Z)</option>
                                <option value="total-desc">Mayor total</option>
                                <option value="total-asc">Menor total</option>
                            </select>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(textoBusqueda))
                    {
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">
                                <i class="bi bi-x-circle"></i> Limpiar búsqueda
                            </button>
                            <span class="ms-2 text-muted">
                                Mostrando @facturasFiltradas.Count de @todasLasFacturas.Count facturas
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (facturas == null)
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-hourglass-split me-1"></i> Cargando...
            </div>
        }
        else if (facturasFiltradas.Count == 0)
        {
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-circle me-1"></i>
                @if (todasLasFacturas.Count == 0)
                {
                    <span>No hay facturas archivadas.</span>
                }
                else
                {
                    <span>No se encontraron facturas con los criterios de búsqueda.</span>
                }
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table table-hover align-middle">
                        <thead class="table-warning">
                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in facturasFiltradas)
                            {
                                <tr>
                                    <td>@f.Id</td>
                                    <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@f.NombreCliente</td>
                                    <td><strong>$@f.Total.ToString("N2")</strong></td>
                                    <td>
                                        <button class="btn btn-success btn-sm me-2" @onclick="() => DesarchivarFactura(f.Id)">
                                            <i class="bi bi-box-arrow-up"></i> Desarchivar
                                        </button>
                                        <button class="btn btn-info btn-sm" @onclick="() => VerDetalle(f.Id)">
                                            <i class="bi bi-eye"></i> Ver detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="mt-3">
            <button class="btn btn-secondary" @onclick="MenuPrincipal">
                <i class="bi bi-arrow-left"></i> Regresar al menú principal
            </button>
        </div>
    }
</div>

@code {
    private List<Factura>? facturas;
    private List<Factura> todasLasFacturas = new();
    private List<Factura> facturasFiltradas = new();
    private bool autenticado = false;
    private string contraseñaIngresada = "";
    private string mensajeError = "";
    private string textoBusqueda = "";
    private string ordenarPor = "fecha-desc";
    private const string CONTRASEÑA_CORRECTA = "admin123";

    private async Task VerificarContraseña()
    {
        if (contraseñaIngresada == CONTRASEÑA_CORRECTA)
        {
            autenticado = true;
            mensajeError = "";
            await CargarFacturas();
        }
        else
        {
            mensajeError = "❌ Contraseña incorrecta";
            contraseñaIngresada = "";
        }
    }

    private async Task VerificarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerificarContraseña();
        }
    }

    private async Task CargarFacturas()
    {
        facturas = await Db.Facturas
            .Where(f => f.Archivada)
            .OrderByDescending(f => f.Fecha)
            .ToListAsync();

        todasLasFacturas = facturas;
        facturasFiltradas = facturas;
        OrdenarFacturas();
    }

    private void FiltrarFacturas()
    {
        if (facturas == null) return;

        var resultado = todasLasFacturas.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var busqueda = textoBusqueda.ToLower();
            resultado = resultado.Where(f =>
                f.NombreCliente.ToLower().Contains(busqueda) ||
                f.Id.ToString().Contains(busqueda) ||
                f.Total.ToString("N2").Contains(busqueda)
            );
        }

        facturasFiltradas = resultado.ToList();
        OrdenarFacturas();
    }

    private void OrdenarFacturas()
    {
        facturasFiltradas = ordenarPor switch
        {
            "fecha-desc" => facturasFiltradas.OrderByDescending(f => f.Fecha).ToList(),
            "fecha-asc" => facturasFiltradas.OrderBy(f => f.Fecha).ToList(),
            "cliente" => facturasFiltradas.OrderBy(f => f.NombreCliente).ToList(),
            "total-desc" => facturasFiltradas.OrderByDescending(f => f.Total).ToList(),
            "total-asc" => facturasFiltradas.OrderBy(f => f.Total).ToList(),
            _ => facturasFiltradas
        };
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        facturasFiltradas = todasLasFacturas;
        OrdenarFacturas();
    }

    private async Task DesarchivarFactura(int id)
    {
        var factura = await Db.Facturas.FindAsync(id);
        if (factura != null)
        {
            var confirmado = await JS.InvokeAsync<bool>("confirm",
                $"¿Seguro que deseas desarchivar la factura de {factura.NombreCliente}?");

            if (confirmado)
            {
                factura.Archivada = false;
                Db.Facturas.Update(factura);
                await Db.SaveChangesAsync();

                await JS.InvokeVoidAsync("alert", "✅ Factura desarchivada correctamente.");
                await CargarFacturas();
                StateHasChanged();
            }
        }
    }

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/detalle-factura/{id}/archivadas");
    }

    private void MenuPrincipal()
    {
        Nav.NavigateTo("/");
    }
}