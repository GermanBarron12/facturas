@page "/faq"
@using facturas
@using Microsoft.EntityFrameworkCore
@inject FacturasDb _db
@inject NavigationManager Nav

<div class="container my-4">
    <!-- Botón superior para regresar -->
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="MenuPrincipal">
            <i class="bi bi-arrow-left"></i> Regresar al menú principal
        </button>
    </div>

    <div class="text-center mb-4">
        <h1 class="fw-bold">❓ Preguntas Frecuentes (Consultas Inteligentes)</h1>
        <p class="text-muted">Análisis automático del sistema de facturación</p>
    </div>

    <div class="row g-4">

        <!-- Artículo más vendido -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">📦 Artículo más vendido (por dinero)</h5>
                    <p class="card-text fs-5 fw-semibold">@ArticuloMasVendido</p>
                </div>
            </div>
        </div>

        <!-- Mes con más ventas -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">📅 Mes con más ventas</h5>
                    <p class="card-text fs-5 fw-semibold">@MesConMasVentas</p>
                </div>
            </div>
        </div>

        <!-- Cliente que más compra -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🧑‍💼 Cliente con mayor gasto</h5>
                    <p class="card-text fs-5 fw-semibold">@ClienteQueMasCompra</p>
                </div>
            </div>
        </div>

        <!-- Ticket promedio -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">💵 Ticket promedio</h5>
                    <p class="card-text fs-5 fw-semibold">@TicketPromedio.ToString("C")</p>
                </div>
            </div>
        </div>

        <!-- Totales por año -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📊 Totales facturados por año</h5>

                    <ul class="list-group">
                        @foreach (var a in TotalesPorAño)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="fw-bold">@a.Key</span>
                                <span>@a.Value.ToString("C")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Artículos más rentables -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">💰 Artículos más rentables</h5>

                    <ul class="list-group">
                        @foreach (var art in ArticulosMasRentables)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@art.Descripcion</span>
                                <span class="fw-bold">@art.TotalVentas.ToString("C")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Facturas por mes -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📆 Cantidad de facturas por mes</h5>

                    <ul class="list-group">
                        @foreach (var mes in FacturasPorMes)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@mes.Key</span>
                                <span>@mes.Value factura(s)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Artículo más comprado por cantidad -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">📦 Artículo más comprado (cantidad)</h5>
                    <p class="card-text fs-5 fw-semibold">@ArticuloMasCompradoPorCantidad</p>
                </div>
            </div>
        </div>

        <!-- Día con más ventas -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">🗓️ Día de la semana con más ventas</h5>
                    <p class="card-text fs-5 fw-semibold">@DiaConMasVentas</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Botón inferior para regresar -->
<div class="container mt-3 mb-4">
    <button class="btn btn-secondary" @onclick="MenuPrincipal">
        <i class="bi bi-arrow-left"></i> Regresar al menú principal
    </button>
</div>

<!-- Componente de scroll to top -->
<BotonScrollTop />

@code {

    // VARIABLES
    string ArticuloMasVendido = "Cargando...";
    string MesConMasVentas = "Cargando...";
    string ClienteQueMasCompra = "Cargando...";
    Dictionary<int, decimal> TotalesPorAño = new();
    List<(string Descripcion, decimal TotalVentas)> ArticulosMasRentables = new();
    decimal TicketPromedio = 0;
    Dictionary<string, int> FacturasPorMes = new();
    string ArticuloMasCompradoPorCantidad = "Cargando...";
    string DiaConMasVentas = "Cargando...";

    protected override async Task OnInitializedAsync()
    {
        // ---- ARTÍCULO MÁS VENDIDO (POR DINERO) - Solo facturas no archivadas
        var artMasV = _db.Articulos
            .Where(a => !_db.Facturas.Any(f => f.Id == a.FacturaId && f.Archivada))
            .GroupBy(a => a.Descripcion)
            .Select(g => new { Desc = g.Key, Total = g.Sum(a => a.Precio * a.Cantidad) })
            .AsEnumerable()
            .OrderByDescending(g => g.Total)
            .FirstOrDefault();

        ArticuloMasVendido = artMasV != null ?
            $"{artMasV.Desc} — {artMasV.Total:C}" : "Sin datos";


        // ---- MES CON MÁS VENTAS - Solo facturas no archivadas
        var mesVentas = _db.Facturas
            .Where(f => !f.Archivada)
            .GroupBy(f => new { f.Fecha.Year, f.Fecha.Month })
            .Select(g => new { g.Key.Year, g.Key.Month, Total = g.Sum(f => f.Total) })
            .AsEnumerable()
            .OrderByDescending(g => g.Total)
            .FirstOrDefault();

        MesConMasVentas = mesVentas != null ?
            $"{mesVentas.Month}/{mesVentas.Year} — {mesVentas.Total:C}" : "Sin datos";


        // ---- MEJOR CLIENTE - Solo facturas no archivadas
        var mejorCliente = _db.Facturas
            .Where(f => !f.Archivada)
            .GroupBy(f => f.NombreCliente)
            .Select(g => new { Cliente = g.Key, Total = g.Sum(f => f.Total) })
            .AsEnumerable()
            .OrderByDescending(g => g.Total)
            .FirstOrDefault();

        ClienteQueMasCompra = mejorCliente != null ?
            $"{mejorCliente.Cliente} — {mejorCliente.Total:C}" : "Sin datos";


        // ---- TOTALES POR AÑO - Solo facturas no archivadas
        TotalesPorAño = await _db.Facturas
            .Where(f => !f.Archivada)
            .GroupBy(f => f.Fecha.Year)
            .Select(g => new { Año = g.Key, Total = g.Sum(f => f.Total) })
            .ToDictionaryAsync(x => x.Año, x => x.Total);


        // ---- ARTÍCULOS MÁS RENTABLES - Solo facturas no archivadas
        var rentables = _db.Articulos
            .Where(a => !_db.Facturas.Any(f => f.Id == a.FacturaId && f.Archivada))
            .GroupBy(a => a.Descripcion)
            .Select(g => new { Descripcion = g.Key, TotalVentas = g.Sum(a => a.Cantidad * a.Precio) })
            .AsEnumerable()
            .OrderByDescending(x => x.TotalVentas)
            .ToList();

        ArticulosMasRentables = rentables
            .Select(x => (x.Descripcion, x.TotalVentas))
            .ToList();


        // ---- TICKET PROMEDIO - Solo facturas no archivadas
        TicketPromedio = await _db.Facturas.AnyAsync(f => !f.Archivada)
            ? await _db.Facturas.Where(f => !f.Archivada).AverageAsync(f => f.Total)
            : 0;


        // ---- FACTURAS POR MES - Solo facturas no archivadas
        FacturasPorMes = _db.Facturas
            .Where(f => !f.Archivada)
            .AsEnumerable()
            .GroupBy(f => f.Fecha.ToString("MMMM yyyy"))
            .Select(g => new { Mes = g.Key, Count = g.Count() })
            .ToDictionary(x => x.Mes, x => x.Count);



        // ---- ARTÍCULO MÁS COMPRADO (CANTIDAD) - Solo facturas no archivadas
        var artCant = _db.Articulos
            .Where(a => !_db.Facturas.Any(f => f.Id == a.FacturaId && f.Archivada))
            .GroupBy(a => a.Descripcion)
            .Select(g => new { Desc = g.Key, Cant = g.Sum(a => a.Cantidad) })
            .AsEnumerable()
            .OrderByDescending(g => g.Cant)
            .FirstOrDefault();

        ArticuloMasCompradoPorCantidad = artCant != null ?
            $"{artCant.Desc} — {artCant.Cant} unidades" : "Sin datos";


        // ---- DÍA CON MÁS VENTAS - Solo facturas no archivadas
        var diaMayor = _db.Facturas
            .Where(f => !f.Archivada)
            .GroupBy(f => f.Fecha.DayOfWeek)
            .Select(g => new { Dia = g.Key.ToString(), Total = g.Sum(f => f.Total) })
            .AsEnumerable()
            .OrderByDescending(g => g.Total)
            .FirstOrDefault();

        DiaConMasVentas = diaMayor != null ?
            $"{diaMayor.Dia} — {diaMayor.Total:C}" : "Sin datos";
    }
    private void MenuPrincipal()
    {
        Nav.NavigateTo("/");
    }
}