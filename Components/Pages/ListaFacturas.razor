@page "/facturas"
@using Microsoft.EntityFrameworkCore
@inject FacturasDb Db
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-4">
    <h1 class="mb-4 text-center text-primary">
        <i class="bi bi-receipt-cutoff me-2"></i> Mis Facturas
    </h1>



    @if (facturas == null)
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-hourglass-split me-1"></i> Cargando...
        </div>
    }
    else if (facturas.Count == 0)
    {
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-circle me-1"></i> No hay facturas registradas.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in facturas)
                        {
                            <tr>
                                <td>@f.Id</td>
                                <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@f.NombreCliente</td>
                                <td><strong>$@f.Total.ToString("N2")</strong></td>
                                <td>
                                    <button class="btn btn-info btn-sm" @onclick="() => VerDetalle(f.Id)">
                                        <i class="bi bi-eye"></i> Ver detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
<div>
    <button class="btn btn-secondary" @onclick="MenuPrincipal">
        <i class="bi bi-arrow-left"></i>Regresar al menu principal
    </button>
</div>

@code {
    private List<Factura>? facturas;

    protected override async Task OnInitializedAsync()
    {
        // Solo mostrar facturas no archivadas
        facturas = await Db.Facturas
            .Where(f => !f.Archivada)
            .ToListAsync();
    }

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/detalle-factura/{id}");
    }

    private void MenuPrincipal()
    {
        Nav.NavigateTo("/");
    }
}