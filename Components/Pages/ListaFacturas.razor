@page "/facturas"
@using Microsoft.EntityFrameworkCore
@inject FacturasDb Db
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-4">
    <!-- Botón superior para regresar -->
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="MenuPrincipal">
            <i class="bi bi-arrow-left"></i> Regresar al menú principal
        </button>
    </div>

    <h1 class="mb-4 text-center text-primary">
        <i class="bi bi-receipt-cutoff me-2"></i> Mis Facturas
    </h1>

    <!-- Barra de búsqueda -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Buscar por cliente, ID o total..."
                               @bind="textoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="FiltrarFacturas" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="filtroFecha" @bind:after="FiltrarFacturas">
                        <option value="todas">Todas las fechas</option>
                        <option value="hoy">Hoy</option>
                        <option value="semana">Esta semana</option>
                        <option value="mes">Este mes</option>
                        <option value="año">Este año</option>
                    </select>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(textoBusqueda) || filtroFecha != "todas")
            {
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle"></i> Limpiar filtros
                    </button>
                    <span class="ms-2 text-muted">
                        Mostrando @facturasFiltradas.Count de @todasLasFacturas.Count facturas
                    </span>
                </div>
            }
        </div>
    </div>

    @if (facturas == null)
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-hourglass-split me-1"></i> Cargando...
        </div>
    }
    else if (facturasFiltradas.Count == 0)
    {
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-circle me-1"></i>
            @if (todasLasFacturas.Count == 0)
            {
                <span>No hay facturas registradas.</span>
            }
            else
            {
                <span>No se encontraron facturas con los criterios de búsqueda.</span>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in facturasFiltradas)
                        {
                            <tr>
                                <td>@f.Id</td>
                                <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@f.NombreCliente</td>
                                <td><strong>$@f.Total.ToString("N2")</strong></td>
                                <td>
                                    <button class="btn btn-info btn-sm" @onclick="() => VerDetalle(f.Id)">
                                        <i class="bi bi-eye"></i> Ver detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Botón inferior para regresar -->
<div class="container mt-3 mb-4">
    <button class="btn btn-secondary" @onclick="MenuPrincipal">
        <i class="bi bi-arrow-left"></i> Regresar al menú principal
    </button>
</div>

<!-- Componente de scroll to top -->
<BotonScrollTop />

@code {
    private List<Factura>? facturas;
    private List<Factura> todasLasFacturas = new();
    private List<Factura> facturasFiltradas = new();
    private string textoBusqueda = "";
    private string filtroFecha = "todas";

    protected override async Task OnInitializedAsync()
    {
        facturas = await Db.Facturas
            .Where(f => !f.Archivada)
            .OrderByDescending(f => f.Fecha)
            .ToListAsync();

        todasLasFacturas = facturas;
        facturasFiltradas = facturas;
    }

    private void FiltrarFacturas()
    {
        if (facturas == null) return;

        var resultado = todasLasFacturas.AsEnumerable();

        // Filtro por texto
        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var busqueda = textoBusqueda.ToLower();
            resultado = resultado.Where(f =>
                f.NombreCliente.ToLower().Contains(busqueda) ||
                f.Id.ToString().Contains(busqueda) ||
                f.Total.ToString("N2").Contains(busqueda)
            );
        }

        // Filtro por fecha
        var hoy = DateTime.Today;
        resultado = filtroFecha switch
        {
            "hoy" => resultado.Where(f => f.Fecha.Date == hoy),
            "semana" => resultado.Where(f => f.Fecha.Date >= hoy.AddDays(-7)),
            "mes" => resultado.Where(f => f.Fecha.Month == hoy.Month && f.Fecha.Year == hoy.Year),
            "año" => resultado.Where(f => f.Fecha.Year == hoy.Year),
            _ => resultado
        };

        facturasFiltradas = resultado.ToList();
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        filtroFecha = "todas";
        facturasFiltradas = todasLasFacturas;
    }

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/detalle-factura/{id}");
    }

    private void MenuPrincipal()
    {
        Nav.NavigateTo("/");
    }
}