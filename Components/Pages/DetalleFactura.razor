@page "/detalle-factura/{Id:int}"
@using Microsoft.EntityFrameworkCore
@inject FacturasDb Db
@inject NavigationManager Nav
@rendermode InteractiveServer

<h2 class="text-center text-primary mt-4">
    <i class="bi bi-file-text me-2"></i> Detalle de la Factura
</h2>

@if (factura == null)
{
    <div class="alert alert-info text-center mt-4">
        <i class="bi bi-hourglass-split me-1"></i> Cargando información...
    </div>
}
else
{
    <div class="container mt-4">
        <div class="card shadow-sm p-4">
            <h4><i class="bi bi-person-fill me-2"></i>Cliente: @factura.NombreCliente</h4>
            <p><i class="bi bi-calendar3 me-2"></i><strong>Fecha:</strong> @factura.Fecha.ToString("dd/MM/yyyy")</p>

            <h5 class="mt-4 text-secondary"><i class="bi bi-cart4 me-2"></i>Artículos</h5>

            <table class="table table-striped mt-3">
                <thead class="table-light">
                    <tr>
                        <th>Descripción</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var art in factura.Articulos)
                    {
                        <tr>
                            <td>
                                <input type="text" class="form-control" @bind="art.Descripcion" />
                            </td>
                            <td>
                                <input type="number" class="form-control" @bind="art.Cantidad" min="1" />
                            </td>
                            <td>
                                <input type="number" class="form-control" @bind="art.Precio" step="0.01" min="0" />
                            </td>
                            <td>@($"${(art.Cantidad * art.Precio):0.00}")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="alert alert-info text-end mt-3">
                <strong>Total: </strong> @($"${CalcularTotal():0.00}")
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-secondary" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i> Volver
                </button>

                <div>
                    <button class="btn btn-danger me-2" @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash"></i> Eliminar factura
                    </button>

                    <button class="btn btn-success" @onclick="GuardarCambios">
                        <i class="bi bi-save me-1"></i> Guardar cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Factura? factura;

    protected override async Task OnInitializedAsync()
    {
        factura = await Db.Facturas
            .Include(f => f.Articulos)
            .FirstOrDefaultAsync(f => f.Id == Id);
    }

    private decimal CalcularTotal()
    {
        return factura?.Articulos.Sum(a => a.Cantidad * a.Precio) ?? 0;
    }

    private async Task GuardarCambios()
    {
        if (factura == null) return;

        factura.Total = CalcularTotal();

        Db.Facturas.Update(factura);
        foreach (var art in factura.Articulos)
        {
            Db.Articulos.Update(art);
        }

        await Db.SaveChangesAsync();
        await Task.Delay(500);

        Nav.NavigateTo($"/detalle-factura/{factura.Id}", forceLoad: true);
    }

    private async Task ConfirmarEliminar()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que deseas eliminar la factura de {factura?.NombreCliente}? Esta acción no se puede deshacer.");

        if (confirmado)
        {
            await EliminarFactura();
        }
    }

    private async Task EliminarFactura()
    {
        if (factura == null) return;

        Db.Articulos.RemoveRange(factura.Articulos);
        Db.Facturas.Remove(factura);

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/facturas", forceLoad: true);
    }

    private void Volver()
    {
        Nav.NavigateTo("/facturas");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}
