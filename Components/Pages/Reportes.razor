@page "/reportes"
@inject FacturasDb Db
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore

<button class="btn btn-secondary mb-3" @onclick="Menu">
    <i class="bi bi-arrow-left"></i> Regresar al menú principal
</button>

<h2 class="text-center text-primary mb-4">
    <i class="bi bi-bar-chart-fill me-2"></i> Reporte de Facturas
</h2>

<div class="card shadow-sm p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Año</label>
            <select class="form-select" @bind="añoSeleccionado" @bind:after="CargarMeses">
                <option value="">-- Selecciona --</option>
                @foreach (var año in años)
                {
                    <option value="@año">@año</option>
                }
            </select>
        </div>

        @if (meses.Any())
        {
            <div class="col-md-4">
                <label class="form-label">Mes</label>
                <select class="form-select" @bind="mesSeleccionado" @bind:after="CargarFacturasDelMes">
                    <option value="">-- Todos --</option>
                    @foreach (var m in meses)
                    {
                        <option value="@m.Mes">@m.NombreMes</option>
                    }
                </select>
            </div>
        }
    </div>
</div>

@if (facturasPorMes.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mes</th>
                <th>Facturas</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in facturasPorMes)
            {
                <tr>
                    <td>@m.NombreMes</td>
                    <td>@m.Cantidad</td>
                    <td>$@m.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (facturasDelMes.Any())
{
    <h4 class="mt-4">Facturas de @nombreMes (@añoSeleccionado)</h4>

    <table class="table table-hover mt-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in facturasDelMes)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.NombreCliente</td>
                    <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>$@f.Total.ToString("N2")</td>
                    <td>
                        <button class="btn btn-info btn-sm"
                                @onclick="() => VerDetalle(f.Id)">
                            <i class="bi bi-eye"></i> Ver detalle
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<int> años = new();
    private List<ResumenMes> facturasPorMes = new();
    private List<ResumenMes> meses = new();
    private List<Factura> facturasDelMes = new();
    private int añoSeleccionado;
    private int mesSeleccionado;
    private string nombreMes = "";

    protected override async Task OnInitializedAsync()
    {
        años = await Db.Facturas
            .Select(f => f.Fecha.Year)
            .Distinct()
            .OrderByDescending(x => x)
            .ToListAsync();
    }

    async Task CargarMeses()
    {
        facturasDelMes.Clear();

        if (añoSeleccionado == 0)
        {
            meses.Clear();
            facturasPorMes.Clear();
            return;
        }

        var lista = await Db.Facturas
            .Where(f => f.Fecha.Year == añoSeleccionado)
            .ToListAsync();

        facturasPorMes = lista
            .GroupBy(f => f.Fecha.Month)
            .Select(g => new ResumenMes
            {
                Mes = g.Key,
                NombreMes = new DateTime(1, g.Key, 1)
                    .ToString("MMMM", new System.Globalization.CultureInfo("es-ES")),
                Cantidad = g.Count(),
                Total = g.Sum(f => f.Total)
            })
            .ToList();

        meses = facturasPorMes;
        mesSeleccionado = 0;
    }

    async Task CargarFacturasDelMes()
    {
        if (mesSeleccionado == 0)
        {
            facturasDelMes.Clear();
            return;
        }

        facturasDelMes = await Db.Facturas
            .Where(f => f.Fecha.Year == añoSeleccionado &&
                        f.Fecha.Month == mesSeleccionado)
            .ToListAsync();

        nombreMes = new DateTime(1, mesSeleccionado, 1)
            .ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));
    }

    void Menu() => Nav.NavigateTo("/");

    void VerDetalle(int id)
    {
        Nav.NavigateTo($"/detalle-factura/{id}?from=reportes");
    }

    public class ResumenMes
    {
        public int Mes { get; set; }
        public string NombreMes { get; set; }
        public int Cantidad { get; set; }
        public decimal Total { get; set; }
    }
}
