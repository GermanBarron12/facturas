@page "/reportes"
@inject FacturasDb Db
@rendermode InteractiveServer

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">
        <i class="bi bi-bar-chart-fill me-2"></i> Reporte de Facturas por Año y Mes
    </h2>

    <div class="card shadow-sm p-4 mb-4">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Selecciona el año</label>
                    <select class="form-select" @bind="añoSeleccionado" @bind:event="onchange">
                    <option value="">-- Selecciona un año --</option>
                    @foreach (var año in añosDisponibles)
                    {
                        <option value="@año">@año</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (facturasPorMes != null && facturasPorMes.Any())
    {
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mes</th>
                    <th>Cantidad de Facturas</th>
                    <th>Total del Mes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mes in facturasPorMes)
                {
                    <tr>
                        <td>@mes.NombreMes</td>
                        <td>@mes.CantidadFacturas</td>
                        <td>$@mes.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-info fw-bold">
                    <td colspan="2" class="text-end">TOTAL DEL AÑO:</td>
                    <td>$@totalAnual.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    }
    else if (añoSeleccionado != 0)
    {
        <div class="alert alert-warning text-center mt-3">
            <i class="bi bi-exclamation-triangle me-1"></i>No se encontraron facturas para este año.
        </div>
    }
</div>

@code {
    private List<int> añosDisponibles = new();
    private int añoSeleccionado;
    private List<ResumenMensual> facturasPorMes = new();
    private decimal totalAnual = 0;

    protected override void OnInitialized()
    {
        // Obtener años disponibles a partir de las facturas existentes
        añosDisponibles = Db.Facturas
            .Select(f => f.Fecha.Year)
            .Distinct()
            .OrderByDescending(a => a)
            .ToList();
    }

    private void CargarDatos()
    {
        if (añoSeleccionado != 0)
        {
            facturasPorMes = Db.Facturas
                .Where(f => f.Fecha.Year == añoSeleccionado)
                .GroupBy(f => f.Fecha.Month)
                .Select(g => new ResumenMensual
                {
                    Mes = g.Key,
                    NombreMes = new DateTime(1, g.Key, 1).ToString("MMMM", new System.Globalization.CultureInfo("es-ES")),
                    CantidadFacturas = g.Count(),
                    Total = g.Sum(f => f.Total)
                })
                .OrderBy(r => r.Mes)
                .ToList();

            totalAnual = facturasPorMes.Sum(r => r.Total);
        }
        else
        {
            facturasPorMes = new();
            totalAnual = 0;
        }
    }

    public class ResumenMensual
    {
        public int Mes { get; set; }
        public string NombreMes { get; set; } = string.Empty;
        public int CantidadFacturas { get; set; }
        public decimal Total { get; set; }
    }

    // Ejecutar CargarDatos cuando cambie añoSeleccionado
    private async Task OnAñoSeleccionadoChanged(int value)
    {
        añoSeleccionado = value;
        CargarDatos();
        await InvokeAsync(StateHasChanged);
    }

    // Actualizar el binding para que llame a OnAñoSeleccionadoChanged
    private int AñoSeleccionado
    {
        get => añoSeleccionado;
        set
        {
            if (añoSeleccionado != value)
            {
                añoSeleccionado = value;
                CargarDatos();
            }
        }
    }
}
