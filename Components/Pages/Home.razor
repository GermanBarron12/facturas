@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav
<h3>Bienvenido al portal de facturación electrónica</h3>
<div>
    <button class="btn btn-primary" @onclick="NuevaFactura">
        <i class="bi bi-file-earmark-plus"></i> Crear nueva factura
    </button>
</div>
<div>
    <button class="btn btn-primary" @onclick="VerFacturas">
        <i class="bi bi-list"></i> Ver facturas
    </button>
</div>
<div>
    <button class="btn btn-primary" @onclick="VerReportes">
        <i class="bi bi-bar-chart"></i> Ver reportes
    </button>
</div>
<div>
    <button class="btn btn-primary" @onclick="Faq">
        <i class="bi bi-question-circle"></i> Preguntas Frecuentes
    </button>
</div>
<div>
    <button class="btn btn-warning" @onclick="VerArchivadas">
        <i class="bi bi-archive"></i> Facturas Archivadas
    </button>
</div>
@code {
    private void NuevaFactura()
    {
        Nav.NavigateTo("/nueva-factura");
    }

    private void VerFacturas()
    {
        Nav.NavigateTo("/facturas");
    }

    private void VerReportes()
    {
        Nav.NavigateTo("/reportes");
    }

    private void Faq()
    {
        Nav.NavigateTo("/faq");
    }

    private void VerArchivadas()
    {
        Nav.NavigateTo("/facturas-archivadas");
    }
}